{
  "name": "bediary-frontend-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "postinstall": "node scripts/patch-voice-android.cjs",
    "start": "expo start",
    "start:lan": "expo start --lan -c",
